{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "src/common/**/*.ts",
    "src/main/kubectl.ts",
    "src/main/cluster-resolver.ts",
    "src/main/exec.ts",
    "src/main/tar.ts",
    "src/main/pod-fs.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ]
}
